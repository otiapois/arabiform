{
  "name": "arabiform",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "arabiform-cli": "node --import tsx scripts/arabiform-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fuzz": "vitest run tests/core/fuzz.test.ts",
    "build": "vite build && node scripts/prerender.mjs",
    "verify:release": "node scripts/verify-release-bundle.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "verify:pixels": "tsx scripts/verify-pdf-pixels.ts && python scripts/verify-pdf-pixels.py",
    "test:e2e": "playwright test",
    "generate:fixtures": "node scripts/generate-fixtures.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "bidi-js": "1.0.3",
    "fast-xml-parser": "5.12.1",
    "fflate": "0.8.2",
    "papaparse": "5.7.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "fast-check": "4.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
